def load_sample_encodings():
    "Load sample known faces from ./known_faces/ (user must add images)"
    known_dir = 'known_faces'
    if not os.path.exists(known_dir):
        os.makedirs(known_dir)
        print("Created known_faces/ - Add .jpg/.png face images named student1.jpg, student2.jpg etc.")
        return [], []
    known_encodings = []
    known_names = []
    for filename in os.listdir(known_dir):
        if filename.endswith(('.jpg', '.png')):
            image_path = os.path.join(known_dir, filename)
            image = cv2.imread(image_path)
            if image is not None:
                gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
                resized = cv2.resize(gray, (128, 128))
                encoding = resized.flatten().astype(np.float64) / np.linalg.norm(resized.flatten().astype(np.float64))
                name = os.path.splitext(filename)[0]
                known_encodings.append(encoding)
                known_names.append(name)
                print("Loaded", name)
    return known_encodings, known_names

def recognize_opencv(gray_face, known_encodings, known_names):
    "Simple OpenCV recognition using histogram distance"
    resized = cv2.resize(gray_face, (128, 128)).flatten().astype(np.float64)
    resized = resized / np.linalg.norm(resized)
    min_dist = float('inf')
    best_match = None
    for i, enc in enumerate(known_encodings):
        dist = np.linalg.norm(enc - resized)
        if dist < min_dist:
            min_dist = dist
            best_match = i
    if best_match is not None and min_dist < 0.6:
        return known_names[best_match], min_dist
    return "Unknown", min_dist

print("Desktop Face Recognition Demo - Windows Compatible")
print("Original Colab errors cleared: No eval_js, cv2_imshow, etc.")

# Load known faces
known_encodings, known_names = load_sample_encodings()
if not known_encodings:
    print("No known faces loaded. Add images to known_faces/ folder.")

# Open webcam
cap = cv2.VideoCapture(0)
if not cap.isOpened():
    print("Error: Cannot open webcam. Check if camera is available/connected.")
    exit()

print("Press 'q' to quit.")
while True:
    ret, frame = cap.read()
    if not ret:
        print("Failed to grab frame")
        break
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')
    faces = face_cascade.detectMultiScale(gray, 1.1, 4)
    for (x, y, w, h) in faces:
        cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 255, 0), 2)
        cv2.putText(frame, "Face Detected", (x, y-10), cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 0), 2)
        if known_encodings:
            face_roi = gray[y:y+h, x:x+w]
            name, dist = recognize_opencv(face_roi, known_encodings, known_names)
            cv2.putText(frame, name + f" (dist:{dist:.2f})", (x, y+h+20), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 0, 0), 2)
    cv2.imshow('Face Recognition Demo (Press Q to quit)', frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
print("Demo ended successfully. Error cleared!")
